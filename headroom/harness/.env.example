# The gateway holds the Anthropic API key and the GitHub token, so the harness needs neither. All optional.

# GATEWAY_URL=http://localhost:3000
# HEADROOM_URL=http://localhost:8787
# MODEL=claude-opus-5-5
# REPO_SMALL=hguerrero/agentgateway-examples
# REPO_LARGE=agentgateway/agentgateway

# Run part of the matrix:
# MODES=search,code            standard, search, code
# HEADROOM=off                 off, on
# REPOS=large                  small, large
# QUESTIONS=commits,issues     repo, commits, issues, prs, contents
# JUDGE=off                    skip the quality judge
# PROMPT_CACHE=off             turn prompt caching off
