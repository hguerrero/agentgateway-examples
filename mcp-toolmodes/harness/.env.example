# The gateway holds the Anthropic API key and the GitHub token, so the harness needs neither. All optional.

# GATEWAY_URL=http://localhost:3000
# MODEL=claude-opus-5-5
# REPO=agentgateway/agentgateway

# Which modes to compare (each is a route on the gateway). Default: all four.
# MODES=standard,search,code,codeSearch
# QUESTIONS=1,3          # run only some questions (1 to 4)
