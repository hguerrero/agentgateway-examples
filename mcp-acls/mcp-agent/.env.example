OPENAI_API_KEY=your-openai-api-key-here

# Identity used by the agent: alice (readonly) or bob (readwrite).
# The token is read from agentgateway-config/keys/<user>.jwt (created by scripts/gen-keys.mjs).
DEMO_USER=alice

# Optional: override the token or gateway address
# MCP_BEARER_TOKEN=eyJ...
# GATEWAY_URL=http://localhost:3000
